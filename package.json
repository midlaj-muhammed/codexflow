{
  "name": "codexflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "pnpm typecheck && turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:openai-e2e": "CODEXFLOW_REAL_OPENAI_E2E=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run packages/runtime/src/openai.e2e.test.ts",
    "test:github-e2e": "node --env-file=.env ./node_modules/vitest/vitest.mjs run packages/delivery/src/github.e2e.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "5.8.3",
    "vitest": "^4.0.0"
  }
}
