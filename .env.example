# Public application identity. No credentials belong in this file.
NEXT_PUBLIC_APP_NAME=CodexFlow

# Server-only OpenAI key for the production RuntimeExecutor. Leave empty until
# deliberately configured in your ignored local .env file; never expose it to Next.js public variables.
OPENAI_API_KEY=

# Opt-in real OpenAI RuntimeExecutor E2E. Keep disabled for ordinary tests.
CODEXFLOW_REAL_OPENAI_E2E=0

# Server-only durable SQLite path for the control plane. The default is a
# temporary path and is unsuitable for production/restarts.
CODEXFLOW_DATABASE_PATH=/var/lib/codexflow/codexflow.sqlite

# Persistent managed source and task-worktree roots. Defaults use the OS temp
# directory for local/ephemeral use; production workers must use durable paths.
CODEXFLOW_PROJECT_ROOT=/var/lib/codexflow/projects
CODEXFLOW_WORKSPACE_ROOT=/var/lib/codexflow/workspaces

# Server-only GitHub credential used by the existing durable delivery flow.
# Leave empty unless that flow is deliberately configured.
CODEXFLOW_GITHUB_TOKEN=

# Opt-in real GitHub delivery E2E. Use only a disposable repository and an
# isolated task-branch workspace. Keep CODEXFLOW_GITHUB_E2E_TOKEN empty here;
# add the token only to your ignored local .env file. The Git remote in the
# disposable workspace must separately use your configured Git credential
# helper or SSH authentication; this variable is only passed to GitHub's REST API.
CODEXFLOW_GITHUB_E2E_ENABLED=false
CODEXFLOW_GITHUB_E2E_TOKEN=
CODEXFLOW_GITHUB_E2E_OWNER=<github-owner>
CODEXFLOW_GITHUB_E2E_REPOSITORY=codexflow-github-e2e
CODEXFLOW_GITHUB_E2E_BASE_BRANCH=main
CODEXFLOW_GITHUB_E2E_WORKSPACE=/tmp/codexflow-github-e2e
CODEXFLOW_GITHUB_E2E_CHANGED_FILE=E2E_MARKER.md

# Interactive GitHub sign-in. Register an OAuth App with the callback URL
# http://localhost:3000/auth/github/callback (or your deployed equivalent).
# Keep the client secret and session secret only in an ignored server .env file.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
CODEXFLOW_SESSION_SECRET=

# Optional but recommended for GitHub App OAuth deployments. When the app is
# authorized but not installed on any repository, CodexFlow uses this to open
# GitHub's installation flow. Set either the slug or the full GitHub install URL.
GITHUB_APP_SLUG=
GITHUB_APP_INSTALL_URL=

# Public origin registered as the GitHub OAuth application's homepage and
# callback base. Required behind reverse proxies that expose an internal URL to
# Next.js, for example https://codexflow.onrender.com (no trailing path).
CODEXFLOW_PUBLIC_URL=
